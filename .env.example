# Copie ce fichier en `.env` et remplis les valeurs. Le `.env` réel n'est JAMAIS commité
# (voir .gitignore) et JAMAIS collé dans le chat.

# ── OpenRouter : le backend LLM (dès le jour 1) ──────────────────────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── LangSmith : observabilité (données JOUET uniquement) ─────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=campaign-agent
